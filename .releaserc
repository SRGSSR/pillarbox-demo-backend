{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "successCmd": "echo ${nextRelease.version} > VERSION"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "LICENSE",
            "label": "License"
          },
          {
            "path": "README.md",
            "label": "Readme"
          }
        ]
      }
    ]
  ]
}
