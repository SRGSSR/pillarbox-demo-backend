{% extends "./html.layout.peb" %}

{% block content %}

<header class="topbar">
  <button type="button" class="btn-icon" popovertarget="sidebar" title="Toggle Sidebar">
    <span class="material-symbols-outlined">menu</span>
  </button>
  {% include "../shared/components/breadcrumbs.component.peb" %}
  {% include "../shared/components/user-menu.component.peb" %}
</header>

{% include "../shared/components/sidebar.component.peb" %}

<div class="app-container">
  {% block mainContent %}{% endblock %}
</div>

{% block footer %}{% endblock %}

{# Cloned by the confirm handler in dashboard.layout.js (imported per page). #}
<template id="confirm-dialog-template">
  <dialog closedby="any" class="confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-description">
    <form method="dialog">
      <div class="confirm-head">
        <span class="confirm-icon material-symbols-outlined" aria-hidden="true"></span>
        <div class="confirm-body">
          <h3 class="confirm-title" id="confirm-title"></h3>
          <p class="confirm-description" id="confirm-description"></p>
        </div>
      </div>
      <footer>
        <button value="cancel" type="submit" class="btn confirm-cancel">Cancel</button>
        <button value="confirm" type="submit" class="btn btn-primary confirm-action">Confirm</button>
      </footer>
    </form>
  </dialog>
</template>

{% endblock %}
