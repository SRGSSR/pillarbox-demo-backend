{% extends "./html.layout.peb" %}

{% block content %}

<header class="topbar">
  <button type="button" class="btn-icon" popovertarget="sidebar" title="Toggle Sidebar">
    <span class="material-symbols-outlined">menu</span>
  </button>
  {% include "../shared/components/breadcrumbs.component.peb" %}
  {% include "../shared/components/user-menu.component.peb" %}
</header>

{% include "../shared/components/sidebar.component.peb" %}

<div class="app-container">
  {% block mainContent %}{% endblock %}
</div>

{% block footer %}{% endblock %}

<script>
  document.addEventListener("click", (e) => {
    document.querySelectorAll("details.dropdown-menu[open]").forEach((d) => {
      if (!d.contains(e.target)) d.removeAttribute("open");
    });
  });
</script>

{% endblock %}
