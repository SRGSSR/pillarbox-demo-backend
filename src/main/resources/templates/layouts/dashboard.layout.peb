{% extends "./html.layout.peb" %}

{% block content %}

<header class="topbar">
  <button type="button" id="sidebar-toggle" class="btn-icon" title="Toggle Sidebar">
    <span class="material-symbols-outlined">menu</span>
  </button>
  {% include "../shared/components/breadcrumbs.component.peb" %}
</header>

{% include "../shared/components/sidebar.component.peb" %}

<div class="app-container">
  {% block mainContent %}{% endblock %}
</div>

{% block footer %}{% endblock %}

<script>
document.getElementById('sidebar-toggle').addEventListener('click', () => {
    document.body.classList.toggle('sidebar-collapsed');
});
</script>

{% endblock %}
