{# @pebvariable name="folder" type="ch.srgssr.pillarbox.backend.domain.model.Folder" #}
{# @pebvariable name="ancestors" type="java.util.List<ch.srgssr.pillarbox.backend.domain.model.Folder>" #}
{# @pebvariable name="deleted" type="java.lang.Boolean" #}
{# @pebvariable name="breadcrumb_current" type="java.lang.String" #}

{% set collapse = (ancestors | length) + (folder is not empty ? 1 : 0) + (breadcrumb_current is not empty ? 1 : 0) > 2 %}

<nav class="breadcrumbs">
  {% if deleted %}
    <span class="page current">Bin</span>

  {% elseif folder is empty and ancestors is empty and breadcrumb_current is empty %}
    <span class="page current">Media Library</span>

  {% else %}
    {# Dragged media can be dropped on the links: the root removes them from
       the current folder, an ancestor receives them. #}
    <a href="/console" class="page"{% if folder is not empty %} data-drop-unassign="{{ folder.id }}"{% endif %}>Media Library</a>

    {% if collapse %}
      <span class="sep">/</span>
      <a href="/console?folderId={{ ancestors[0].id }}" class="page" data-drop-folder="{{ ancestors[0].id }}">{{ ancestors[0].name }}</a>
      <span class="sep">/ ... /</span>
      {% if breadcrumb_current is not empty %}
        <span class="page current">{{ breadcrumb_current }}</span>
      {% elseif folder is not empty %}
        <span class="page current">{{ folder.name }}</span>
      {% else %}
        {% set lastIndex = (ancestors | length) - 1 %}
        <span class="page current">{{ ancestors[lastIndex].name }}</span>
      {% endif %}

    {% else %}
      {% for ancestor in ancestors %}
        <span class="sep">/</span>
        <a href="/console?folderId={{ ancestor.id }}" class="page" data-drop-folder="{{ ancestor.id }}">{{ ancestor.name }}</a>
      {% endfor %}

      {% if folder is not empty %}
        <span class="sep">/</span>
        {% if breadcrumb_current is not empty %}
          <a href="/console?folderId={{ folder.id }}" class="page">{{ folder.name }}</a>
        {% else %}
          <span class="page current">{{ folder.name }}</span>
        {% endif %}
      {% endif %}

      {% if breadcrumb_current is not empty %}
        <span class="sep">/</span>
        <span class="page current">{{ breadcrumb_current }}</span>
      {% endif %}
    {% endif %}
  {% endif %}
</nav>
