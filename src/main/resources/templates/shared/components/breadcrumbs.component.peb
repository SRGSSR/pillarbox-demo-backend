{# @pebvariable name="folder" type="ch.srgssr.pillarbox.backend.domain.model.Folder" #}
{# @pebvariable name="ancestors" type="java.util.List<ch.srgssr.pillarbox.backend.domain.model.Folder>" #}
{# @pebvariable name="deleted" type="java.lang.Boolean" #}
{# @pebvariable name="breadcrumb_current" type="java.lang.String" #}

<nav class="breadcrumbs">
  {% if deleted %}
    <span class="page current">Bin</span>

  {% elseif folder is empty and ancestors is empty and breadcrumb_current is empty %}
    <span class="page current">Media Library</span>

  {% else %}
    <a href="/console" class="page">Media Library</a>

    {% for ancestor in ancestors %}
      <span class="sep">/</span>
      <a href="/console?folderId={{ ancestor.id }}" class="page">{{ ancestor.name }}</a>
    {% endfor %}

    {% if folder is not empty %}
      <span class="sep">/</span>
      {% if breadcrumb_current is not empty %}
        <a href="/console?folderId={{ folder.id }}" class="page">{{ folder.name }}</a>
      {% else %}
        <span class="page current">{{ folder.name }}</span>
      {% endif %}
    {% endif %}

    {% if breadcrumb_current is not empty %}
      <span class="sep">/</span>
      <span class="page current">{{ breadcrumb_current }}</span>
    {% endif %}
  {% endif %}
</nav>
