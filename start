#!/bin/bash

warn() { echo -e "\033[33m$1\033[0m"; }
error() { echo -e "\033[31m$1\033[0m"; }

# Usage function
usage() {
  warn "Usage: $0 [options]"
  echo ""
  echo "Options:"
  echo "  -k, --keep      Keep Docker containers running after the script exits"
  echo "  -p, --port N    Listen on port N instead of 8080"
  echo "  -h, --help      Show this help message"
  echo ""
  echo "Example:"
  echo "  $0 --keep       Launch app and keep the Docker containers up on exit"
  echo ""
  echo "While it runs, type rs and Enter to restart the application."
  echo ""
  exit 1
}

KEEP_DOCKER=false
APP_ARGS=()

# Parse Arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -k|--keep) KEEP_DOCKER=true ;;
        -h|--help) usage ;;
        -p|--port) APP_ARGS+=("-port=$2"); shift ;;
        *) error "Unknown option: $1"; usage ;;
    esac
    shift
done

cleanup() {
    trap '' SIGINT SIGTERM EXIT

    if [ "$KEEP_DOCKER" = true ]; then
        warn "[Pillarbox] Keeping Docker containers running."
    else
        warn "[Pillarbox] Shutting down local environment..."
        docker compose down
    fi
    exit
}

trap cleanup SIGINT SIGTERM EXIT

cd "$(dirname "$0")" || exit 1

if [ ! -d node_modules ]; then
    echo "[Pillarbox] Installing frontend dependencies..."
    npm ci || exit 1
fi

echo "[Pillarbox] Starting Docker containers..."
docker compose up -d --wait || exit 1

# esbuild watches the stylesheets and scripts, Pebble reads the templates from the sources, and a
# Kotlin change compiles once and restarts the application process.
node scripts/dev.mjs "${APP_ARGS[@]}"
